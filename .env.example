# ── Ollama Cloud (LLM) ──────────────────────────────────────────────────────
# Sign up at https://ollama.com — get an API key
OLLAMA_API_KEY=your-ollama-cloud-api-key
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma3:12b

# ── Embeddings (for persistent memory / pgvector search) ──────────────────────
# Uses the same Ollama instance. nomic-embed-text produces 768-dim vectors.
EMBEDDING_MODEL=nomic-embed-text

# ── Groq (STT — free tier: 2,000 requests/day) ───────────────────────────────
# Sign up at https://console.groq.com — no credit card needed
GROQ_API_KEY=gsk_your_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3

# ── LiveKit (get from cloud.livekit.io → free tier) ──────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Edge-TTS voice (no API key needed — free Microsoft neural voices) ────────
EDGE_TTS_VOICE=en-GB-RyanNeural

# ── Supabase PostgreSQL (free tier at supabase.com) ──────────────────────────
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=3000
AGENT_SECRET=change-this-to-a-random-secret
# Required: protects /api/app/*, /api/chat/*, /api/verify-identity,
# /api/register-token, /api/call/push, /api/test/call.
# Generate with: openssl rand -hex 32
# Pass to the Flutter build: flutter build apk --dart-define=APP_API_KEY=<value>
APP_API_KEY=change-this-to-a-random-secret
BACKEND_URL=http://localhost:3000
# Optional: lock CORS down to a specific origin (default allows all)
# CORS_ORIGIN=https://your-app.example